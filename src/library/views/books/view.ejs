<%- include('../parts/layout-start', {title: title}) %>
<%- include('../parts/menu') %>

<h1><%= title %></h1>


<div class="container">
    <div class="row">
        <div class="col-sm-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><%= book.title %></h5>
                    <p class="card-text"><%= book.description %></p>

                    <div class="text-right">
                        <a class="btn btn-sm btn-primary" href="/books/update/<%= book.id %>">
                            <i class="fa fa-pencil" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-4">
            <div id="list" class="list-group">

            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-4">
            <div class="form-group">
                <label for="username">username</label>
                <input
                        placeholder="username"
                        type="text"
                        id="username"
                        class="form-control"
                >
            </div>
            <div class="form-group">
                <label for="text">message</label>
                <textarea
                        placeholder="message"
                        class="form-control"
                        id="text"
                ></textarea>
            </div>
            <button type="submit" id="send" class="btn btn-primary">send</button>
        </div>
    </div>

</div>

<script>
    const roomName = location.pathname.split('/').pop();
    const socket = io({query: `roomName=${roomName}`});

    console.log('Current room:', roomName);
    console.log('Socket URL:', location.origin);
    
    const boxList       = document.querySelector('#list');
    const inputUsername = document.querySelector('#username');
    const inputText     = document.querySelector('#text');
    const send      = document.querySelector('#send');

    const getTmp = (msg) => {
        return `
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <small>${msg.username}</small>
                        <small class="text-muted">${msg.timestamp}</small>
                    </div>
                    <p class="mb-1">${msg.text}</p>
                </div>
        `;
    };

    socket.on('message-to-book', (msg) => {
        const div = getTmp(msg)
        boxList.insertAdjacentHTML('beforeend', div)
    });

    send.addEventListener('click', () => {
        socket.emit('message-to-book', {
            username: inputUsername.value,
            text: inputText.value,
        })
    })
</script>
<%- include('../parts/layout-end') %>